{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; robotaxi-actor / vehicle-design-actor / itonami ride on; a tailnet control
 ;; plane is just another sealed-intelligence ⊣ independent-governor StateGraph.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; canonical did:key + IPNS-name derivation (ADR-2607050100) — replaces
        ;; this repo's own copy-pasted base58btc/base36/did-key/ipns-name.
        io.github.kotoba-lang/org-ietf-ed25519
        {:sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/tech-ipfs-specs-ipns
        {:sha "f2563eb1cb010c96f6dec1dfbd468fac93367498"}
        ;; CIDv1(raw, sha2-256) for signed desired-state blocks. Mirrors and
        ;; heads are discovery only; the CID remains the byte identity.
        io.github.kotoba-lang/io-multiformats
        {:git/sha "c5963264a8da78ece878b04da18225abdbb84457"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; clojure -M:dev:run  → drive a tailnet through one CoordinationActor
  :run {:main-opts ["-m" "kekkai.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
